{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "decision": { "type": "string", "enum": ["PASS", "NEEDS_HUMAN", "BLOCK"] },
    "headSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "baseSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "testedSha": { "type": "string", "pattern": "^[a-f0-9]{40}$" },
    "summary": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "findings": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 10,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    }
  },
  "required": [
    "decision",
    "headSha",
    "baseSha",
    "testedSha",
    "summary",
    "findings",
    "evidence",
    "uncertainties"
  ]
}
