{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "enabledManagers": ["bun", "mise", "github-actions"],
  "timezone": "America/Guayaquil",
  "schedule": ["before 10am on wednesday"],
  "prConcurrentLimit": 3,
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "rangeStrategy": "bump",
  "separateMinorPatch": false,
  "automerge": false,
  "automergeType": "pr",
  "platformAutomerge": true,
  "dependencyDashboard": true,
  "major": {
    "dependencyDashboardApproval": true
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "vulnerabilityAlerts": {
    "enabled": true,
    "dependencyDashboardApproval": false,
    "minimumReleaseAge": "0 days",
    "schedule": ["at any time"],
    "groupName": null,
    "prConcurrentLimit": 1
  },
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor", "pin", "pinDigest", "digest"],
      "groupName": "Weekly dependencies",
      "automerge": true,
      "description": "One routine batch; native auto-merge waits for required CI."
    },
    {
      "matchManagers": ["github-actions"],
      "pinDigests": true
    }
  ]
}
