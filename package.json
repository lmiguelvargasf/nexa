{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.3",
  "engines": {
    "node": ">=24.21.0 <25",
    "bun": ">=1.4.3"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:pull": "supabase db pull",
    "db:types": "mkdir -p src/db && supabase gen types typescript --local > src/db/database.types.ts",
    "email:dev": "email dev --dir emails"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.85",
    "@ai-sdk/openai": "^4.0.99",
    "@hookform/resolvers": "^5.9.2",
    "@sentry/nextjs": "^11.8.0",
    "@stripe/react-stripe-js": "^7.0.0",
    "@stripe/stripe-js": "^10.1.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.104.5",
    "ai": "^7.0.148",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.61.0",
    "next": "^16.4.2",
    "posthog-js": "^1.438.13",
    "posthog-node": "^5.56.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "react-email": "^6.11.3",
    "resend": "^6.34.1",
    "shadcn": "^4.22.1",
    "stripe": "^22.6.2",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@playwright/test": "^1.64.1",
    "@react-email/ui": "^6.11.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "supabase": "^2.121.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.9",
    "hono": "4.13.13",
    "ip-address": "10.7.4",
    "next": "16.4.2",
    "postcss": "8.5.31",
    "protobufjs": "7.6.6",
    "qs": "6.16.1",
    "ws": "8.22.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@sentry/cli",
    "core-js",
    "esbuild",
    "msw",
    "protobufjs",
    "sharp",
    "supabase",
    "unrs-resolver"
  ]
}
