{
  "name": "nexa",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.21.0 <25",
    "bun": ">=1.4.2"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "test": "vitest",
    "test:run": "vitest run",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:pull": "supabase db pull",
    "db:types": "mkdir -p src/db && supabase gen types typescript --local > src/db/database.types.ts",
    "email:dev": "email dev --dir emails"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.127",
    "@ai-sdk/openai": "^3.0.124",
    "@hookform/resolvers": "^5.4.0",
    "@sentry/nextjs": "^10.76.0",
    "@stripe/react-stripe-js": "^6.4.0",
    "@stripe/stripe-js": "^9.7.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.117.2",
    "@t3-oss/env-nextjs": "^0.13.11",
    "@tanstack/react-query": "^5.100.14",
    "ai": "^6.0.300",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.17.0",
    "next": "^16.3.8",
    "posthog-js": "^1.435.8",
    "posthog-node": "^5.55.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.89.0",
    "react-email": "^6.11.0",
    "resend": "^6.32.0",
    "shadcn": "^4.21.1",
    "stripe": "^22.2.3",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@playwright/test": "^1.60.0",
    "@react-email/ui": "^6.11.0",
    "@tailwindcss/postcss": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "24.12.4",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^29.1.1",
    "supabase": "^2.101.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "brace-expansion": "5.0.12",
    "fast-uri": "3.1.8",
    "hono": "4.13.12",
    "ip-address": "10.7.3",
    "next": "16.3.8",
    "postcss": "8.5.28",
    "protobufjs": "7.6.6",
    "qs": "6.16.0",
    "ws": "8.21.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "@sentry/cli",
    "core-js",
    "esbuild",
    "msw",
    "protobufjs",
    "sharp",
    "supabase",
    "unrs-resolver"
  ]
}
